# Copy this file to `.env` and fill in the value to have the contact form
# post straight to your inbox.
#
# Easiest option — Web3Forms (free, no account needed beyond an email):
#   1. Go to https://web3forms.com
#   2. Enter codifylabs.pk@gmail.com, get an access key by email
#   3. Set the line below to:
#      REACT_APP_FORM_ENDPOINT=https://api.web3forms.com/submit
#      and add your key as `access_key` in src/pages/Contact.js
#
# Or Formspree (https://formspree.io) — create a form, paste its endpoint:
#   REACT_APP_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
#
# Leave this unset and the contact form falls back to opening WhatsApp with
# all the details pre-filled, which always works.

REACT_APP_FORM_ENDPOINT=
